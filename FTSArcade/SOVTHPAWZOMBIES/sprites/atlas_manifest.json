{
  "version": "0.2.0",
  "cell_size": 64,
  "grid": {"columns": 8, "rows": 8},
  "filter": "nearest",
  "atlases": {
    "player": {
      "file": "player_atlas.png",
      "states": {
        "idle": {"row": 0, "frames": 8, "fps": 4, "loop": true},
        "walk": {"row": 1, "frames": 8, "fps": 10, "loop": true},
        "aim": {"row": 2, "frames": 8, "fps": 0, "loop": false, "driven_by": "charge_ratio"},
        "putt": {"row": 3, "frames": 8, "fps": 12, "loop": false},
        "melee": {"row": 4, "frames": 8, "fps": 16, "loop": false},
        "hurt": {"row": 5, "frames": 6, "fps": 10, "loop": false},
        "die": {"row": 6, "frames": 6, "fps": 8, "loop": false},
        "ready": {"row": 7, "frames": 4, "fps": 4, "loop": true}
      }
    },
    "zombieA": {
      "file": "zombie_a_atlas.png",
      "states": {
        "idle": {"row": 0, "frames": 6, "fps": 4, "loop": true},
        "walk": {"row": 1, "frames": 6, "fps": 8, "loop": true},
        "hurt": {"row": 2, "frames": 6, "fps": 12, "loop": false},
        "die": {"row": 3, "frames": 6, "fps": 8, "loop": false}
      }
    }
  }
}
